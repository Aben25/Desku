{
  "name": "desku-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desku backend engine: phone <-> GPT-Live voice session, delegated brain, memory and proactive check-ins.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@composio/core": "^0.22.0",
    "openai": "^7.28.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
