# Required, with api.agents.read/write and api.responses.write. Never ship this to the phone: the phone talks to this server, the server talks to OpenAI.
OPENAI_API_KEY=sk-...
# Required. Shared secret the phone sends when it connects (ws://HOST:8787/device?token=...).
DEVICE_TOKEN=change-me-to-a-long-random-string

# Optional
PORT=8787
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
OPENAI_PROJECT=proj_2apst5kE7CvBS51WxiS1MWax
# Saved "Desku" agent (Agents API) that does the thinking for delegated work. Leave empty to
# create one from ../agent/desku-agent.json on first start. The server keeps it in sync with
# that file.
DESKU_AGENT_ID=
# Close the paid voice session after this many quiet seconds ($0.05/min while open).
IDLE_CLOSE_SECONDS=120
DATA_DIR=./data
# IANA zone used when telling the models what time it is.
TIME_ZONE=America/New_York

# Call me when I'm away (AgentPhone, https://agentphone.ai). Key: dashboard → Settings → API Keys.
AGENTPHONE_API_KEY=
# Desku's AgentPhone number (calls come from here) and your own phone, both E.164.
AGENTPHONE_NUMBER=+16282841240
OWNER_PHONE=
# Call if a spoken check-in gets no reply for this long, or right away if the desk phone is offline.
AWAY_CALL_AFTER_SECONDS=60
# Local hours when Desku never calls (start-end, 24h).
QUIET_HOURS=22-8

# Composio: the user's apps (Calendar, Gmail, Slack, ...). Platform project key (ak_...).
COMPOSIO_API_KEY=
# Stable Composio user ID for Desku's one owner; connections are stored under it.
COMPOSIO_USER_ID=desku-owner
